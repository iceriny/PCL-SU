<Grid x:Class="PCL.MyMsgCompDependency"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:PCL"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
      MinWidth="400" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-4" />
            <TranslateTransform x:Name="TransformPos" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border CornerRadius="7" Background="{DynamicResource ColorBrushBackground}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20" ShadowDepth="2"
                              RenderingBias="Performance" Opacity="0.8" />
        </Border.Effect>
        <Grid Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LabTitle" FontSize="23" Foreground="{DynamicResource ColorBrush2}" Margin="7,-1,70,9" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <Grid Grid.Row="3" Margin="7,0,8,17" MinHeight="72">
                <StackPanel x:Name="PanChecking" VerticalAlignment="Center">
                    <TextBlock x:Name="LabStatus" FontSize="15" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" />
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource ColorBrush6}" Margin="0,15,0,0" ClipToBounds="True">
                        <Border x:Name="BarProgress" CornerRadius="2" Background="{DynamicResource ColorBrush3}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
                <my:MyScrollViewer x:Name="PanResult" Visibility="Collapsed" Opacity="0" VerticalAlignment="Top"
                                   MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
                    <TextBox x:Name="LabResult" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="15"
                             Foreground="{DynamicResource ColorBrush1}" FontFamily="{DynamicResource LaunchFontFamily}"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="1" AllowDrop="False" />
                </my:MyScrollViewer>
            </Grid>
            <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Margin="80,0,8,0">
                <my:MyButton x:Name="BtnWithDependencies" Visibility="Collapsed" Opacity="0" ColorType="Highlight"
                             Click="WithDependencies_Click" Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
                <my:MyButton x:Name="BtnCurrentOnly" Visibility="Collapsed" Opacity="0" Click="CurrentOnly_Click"
                             Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
                <my:MyButton x:Name="BtnCancel" Click="Cancel_Click" Margin="12,0,0,0" TextPadding="7" Padding="5,0" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
