<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="using:PCL.Views.Shell"
        xmlns:ui="using:PCL.UI.Controls"
        mc:Ignorable="d"
        d:DesignWidth="850"
        d:DesignHeight="500"
        x:Class="PCL.Views.MainWindow"
        Width="850"
        Height="500"
        MinWidth="810"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        CanResize="True"
        TransparencyBackgroundFallback="{DynamicResource ColorBrushBackground}"
        Title="Plain Craft Launcher SU">
    <Grid x:Name="PanRoot"
          Background="Transparent">
        <ui:MyDropShadow x:Name="ShadowHost"
                         Elevation="{x:Static ui:SurfaceElevation.Overlay}"
                         CornerRadius="{Binding CornerRadius, ElementName=PanBack}">
            <ui:SuperellipseBorder x:Name="PanBack"
                    CornerRadius="{x:Static ui:CornerRadii.Window}"
                    ClipToBounds="True">
                <!-- 让标题栏、页面和弹窗先合成为一层，再由外框一次裁出抗锯齿边缘。 -->
                <Grid x:Name="PanForm"
                      OpacityMask="White"
                      RowDefinitions="Auto,*">
                    <Grid x:Name="ImgBack"
                          Grid.Row="1"
                          ClipToBounds="True"
                          IsHitTestVisible="False">
                        <Image x:Name="ImgBackImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Grid>
                    <shell:TitleBar x:Name="TitleBar"
                                    Grid.Row="0" />
                    <ui:SuperellipseBorder x:Name="RectLeftBackground"
                            Grid.Row="1"
                            Width="0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource ColorBrushTransparentBackground}"
                            IsHitTestVisible="False"
                            Elevation="{x:Static ui:SurfaceElevation.Surface}" />
                    <Grid x:Name="PanMain"
                          Grid.Row="1"
                          ColumnDefinitions="Auto,*">
                        <ContentControl x:Name="PageLeftHost"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        IsVisible="False" />
                        <ContentControl x:Name="PageRightHost"
                                        Grid.Column="1" />
                    </Grid>
                    <Grid x:Name="PanHintAnchor"
                          Grid.RowSpan="2"
                          ZIndex="1"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom">
                        <StackPanel x:Name="PanHint"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" />
                    </Grid>
                    <shell:ExtraButtonsPanel x:Name="PanExtraButtons"
                                             Grid.Row="1" />
                    <Panel x:Name="PanDialogLayer"
                           Grid.RowSpan="2"
                           ZIndex="2"
                           IsVisible="False"
                           Opacity="0">
                        <ui:SuperellipseBorder x:Name="BorDialogMask"
                                Background="#00000000" />
                        <ui:MyScrollViewer x:Name="SclDialogHost"
                                      MinWidth="400"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      BringIntoViewOnFocusChange="False">
                            <Panel x:Name="PanDialogHost"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center" />
                        </ui:MyScrollViewer>
                    </Panel>
                </Grid>
            </ui:SuperellipseBorder>
        </ui:MyDropShadow>
    </Grid>
</Window>
