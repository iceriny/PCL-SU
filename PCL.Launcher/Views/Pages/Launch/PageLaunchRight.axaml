<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Launch.PageLaunchRight">
    <ui:MyScrollViewer x:Name="PanBack"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain"
                    Margin="25,25,25,10"
                    Grid.IsSharedSizeScope="True">
            <StackPanel x:Name="PanCustom" />

            <ui:MyCard x:Name="PanLog"
                       Margin="0,0,0,15"
                       IsVisible="False"
                       Title="{loc:Loc Launch.Right.Log.Title}">
                <TextBlock x:Name="LabLog"
                           Margin="20,38,20,18"
                           TextWrapping="Wrap" />
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>
